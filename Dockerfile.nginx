# ── Étape 1 : Build du frontend React/Vite ──────────────────────────────────
FROM node:20-slim AS frontend-builder

# Pas /app : quand ce dossier a le même nom que app/app/ (le café), Rollup perd
# l'entrée HTML racine (landing) en silence — index.html n'apparaît plus dans dist/.
WORKDIR /build

COPY app/package*.json ./
RUN npm ci

COPY app/ .
# app/tsconfig.json mappe @shared/* vers ../server/src/* : le typecheck a besoin des types du serveur
COPY server/src /server/src

# VITE_API_URL et VITE_GOOGLE_CLIENT_ID sont injectés au build (baked dans le JS)
ARG VITE_API_URL=http://localhost:3001
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

RUN npm run build

# ── Étape 2 : Nginx sert les fichiers statiques + proxy vers le serveur ───────
FROM nginx:alpine

# Copier les fichiers buildés à la racine de nginx (servi depuis gamitask.gmaxdev.com)
COPY --from=frontend-builder /build/dist /usr/share/nginx/html

# Copier la config nginx
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
