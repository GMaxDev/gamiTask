# ── Copier ce fichier en .env.prod et remplir les valeurs ──────────────────
# Ne jamais committer .env.prod dans git !

# URL publique de ton serveur (utilisée pour construire le frontend)
VITE_API_URL=http://gmaxdev.com

# Google OAuth (même valeur que server/.env)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Secret JWT — CHANGE CETTE VALEUR, min 32 caractères aléatoires
JWT_SECRET=remplace_par_une_vraie_valeur_secrete_longue

# Ton email Google (aura les droits admin dans l'app)
ADMIN_EMAIL=ton.email@gmail.com
