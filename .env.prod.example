# ── Copier ce fichier en .env.prod et remplir les valeurs ──────────────────
# Ne jamais committer .env.prod dans git !

# URL publique de ton serveur (utilisée pour construire le frontend)
VITE_API_URL=http://gmaxdev.com

# Google OAuth (même valeur que server/.env)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Secret JWT — CHANGE CETTE VALEUR, min 32 caractères aléatoires
JWT_SECRET=remplace_par_une_vraie_valeur_secrete_longue
# Chiffre les jetons Twitch en base : 32 octets en hex (`openssl rand -hex 32`)
TOKEN_KEY=remplace_par_64_caracteres_hexadecimaux

# Ton email Google (aura les droits admin dans l'app)
ADMIN_EMAIL=ton.email@gmail.com

# Twitch — app « gamiTask » (dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=YOUR_TWITCH_CLIENT_ID_HERE
TWITCH_CLIENT_SECRET=YOUR_TWITCH_CLIENT_SECRET_HERE
# Doit matcher exactement une des « URL de redirection OAuth » enregistrées sur l'app Twitch
TWITCH_REDIRECT_URI=https://gamitask.gmaxdev.com/auth/twitch/callback
# URL publique du client, où renvoyer l'utilisateur une fois le compte Twitch lié
APP_URL=https://gamitask.gmaxdev.com
